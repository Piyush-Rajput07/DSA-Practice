class Solution {
  public:
    vector<int> sieve(int n) {
        vector<bool> isPrime(n+1, true); //initialising with all true values
        vector<int> res;
        
        for(int i=2; i<=n; i++) {
            if(isPrime[i]) {
                res.push_back(i);
                for(int j=i*2; j<=n; j=j+i) {
                    isPrime[j] = false; //discarding multiples of that no.
                }
            }
        }
        return res;
    }
};
