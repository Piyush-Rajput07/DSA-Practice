class Solution {
  public:
    vector<int> findTwoElement(vector<int>& arr) {
        int n = arr.size();
        unordered_set<int> s;
        vector<int> ans;
        long long a, b;
        
        long long expSum = 1LL*n*(n+1)/2, actualSum = 0; //forcing to 64-bit 
        
        for(int i=0; i<n; i++) {
            actualSum += arr[i];
            if(s.find(arr[i]) != s.end()) {
                a = arr[i];
                ans.push_back(a);
            }
            s.insert(arr[i]);
        }
        b = expSum + a - actualSum;
        ans.push_back(b);
        
        return ans;
    }
};
